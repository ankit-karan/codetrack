# ----- CodeTrack backend environment -----
# Copy this file to `.env` in the server/ folder and fill in real values.
# NEVER commit the real .env file to Git.

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority

# Long random string used to sign JWTs (e.g. `openssl rand -hex 64` or a password manager secret)
JWT_SECRET=replace_with_a_long_random_secret

# How long issued tokens stay valid (optional)
JWT_EXPIRES_IN=7d

# Port the API listens on
PORT=5000

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# development | production | test
NODE_ENV=development
