# ----- CodeTrack frontend environment -----
# Copy this file to `.env` in the client/ folder if you need to override defaults.
# In local development NO configuration is needed: Vite proxies /api → http://localhost:5000.

# Base URL of the REST API. Leave unset in development (uses the Vite proxy).
# For a deployed backend set the absolute URL, e.g.:
# VITE_API_URL=https://codetrack-api-a6i1.onrender.com/api
VITE_API_URL=/api

# Target the dev proxy forwards /api requests to (optional).
# VITE_PROXY_TARGET=http://localhost:5000
